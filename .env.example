# Local PostgreSQL connection used by Drizzle. Keep credentials out of Git.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tattvam_jewels

# Generate a private random value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3100

# Only used by the owner provisioning CLI; the password is entered interactively.
OWNER_NAME=
OWNER_EMAIL=

